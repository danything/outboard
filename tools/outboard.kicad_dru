(version 1)
# Rules for the KiCad DRC that CI runs on the exported board (tools/kicad-drc.ts).
# Limits are JLCPCB's standard process with a margin.

(rule "track width"
  (condition "A.Type == 'track'")
  (constraint track_width (min 0.15mm)))

(rule "via"
  (condition "A.Type == 'via'")
  (constraint hole_size (min 0.3mm))
  (constraint via_diameter (min 0.6mm))
  (constraint annular_width (min 0.13mm)))

(rule "clearance"
  (constraint clearance (min 0.15mm)))

(rule "hole to hole"
  (constraint hole_to_hole (min 0.5mm)))

(rule "hole to copper"
  (constraint hole_clearance (min 0.25mm)))
