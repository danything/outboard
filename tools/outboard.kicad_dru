(version 1)
# Rules for the KiCad DRC that CI runs on the exported board (tools/kicad-drc.ts).
# The numbers are the `design` column of checks/rules.ts (4 layers); a test in
# tools/tools.test.ts fails when the two differ. docs/checks.md says which of
# the two checkers guards what.

(rule "track width"
  (condition "A.Type == 'track'")
  (constraint track_width (min 0.15mm)))

(rule "via"
  (condition "A.Type == 'via'")
  (constraint hole_size (min 0.3mm))
  (constraint via_diameter (min 0.6mm))
  (constraint annular_width (min 0.15mm)))

(rule "clearance"
  (constraint clearance (min 0.15mm)))

(rule "hole to hole"
  (constraint hole_to_hole (min 0.5mm)))

(rule "hole to copper"
  (constraint hole_clearance (min 0.3mm)))

# Replaces the 0.5 mm of the exported board setup.
(rule "edge"
  (constraint edge_clearance (min 0.3mm)))

# The connector maker's land pattern puts contacts 11 and 12 of the PCIe slot
# 0.2 mm from the key notch (EDGE_EXCEPTIONS in checks/rules.ts).
(rule "edge at J3"
  (condition "A.memberOfFootprint('J3') || B.memberOfFootprint('J3')")
  (constraint edge_clearance (min 0.2mm)))
